# ==============================================================================
# LLM Chat Platform - Environment Configuration Blueprint (.env.example)
# ==============================================================================

# Application Ports
# Note: Host port 3000 is occupied by another system process, so frontend defaults to 3001.
FRONTEND_PORT=3001
BACKEND_PORT=8080

# PostgreSQL 18 Configuration (Users, Balances, Referrals)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=llm_chat
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/llm_chat?sslmode=disable

# MongoDB 8 Configuration (Chat History, Messages, Context)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=llm_chat
MONGO_URI=mongodb://localhost:27017

# RouterAI.ru Provider Configuration
ROUTERAI_API_KEY=your_routerai_api_key_here
ROUTERAI_BASE_URL=https://routerai.ru/api/v1

# VK OAuth 2.0 Configuration
VK_CLIENT_ID=your_vk_client_id
VK_CLIENT_SECRET=your_vk_client_secret
VK_REDIRECT_URI=http://localhost:3001/api/auth/vk/callback

# JWT & Session Security
JWT_SECRET=change_this_to_a_secure_random_secret_in_production
JWT_EXPIRATION_HOURS=72
